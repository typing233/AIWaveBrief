# === 必需 ===
FIRECRAWL_API_KEY=fc-your-key-here
OPENAI_API_KEY=sk-your-key-here

# === 调度配置（可选） ===
# AIWAVEBRIEF_SCHEDULE_ENABLED=true
# AIWAVEBRIEF_SCHEDULE_TIME=08:00
# AIWAVEBRIEF_SCHEDULE_TIMEZONE=Asia/Shanghai

# === 抓取配置（可选） ===
# AIWAVEBRIEF_SCRAPING_MAX_RETRIES=3
# AIWAVEBRIEF_SCRAPING_MAX_WORKERS=3
# AIWAVEBRIEF_SCRAPING_MAX_ARTICLES_PER_SOURCE=10

# === 去重配置（可选） ===
# AIWAVEBRIEF_DEDUP_ENABLED=true
# AIWAVEBRIEF_DEDUP_URL_TTL_DAYS=30
# AIWAVEBRIEF_DEDUP_TITLE_SIMILARITY_THRESHOLD=0.85

# === 推送配置 - 邮件（可选） ===
# AIWAVEBRIEF_PUSH_ENABLED=true
# AIWAVEBRIEF_PUSH_EMAIL_SMTP_HOST=smtp.gmail.com
# AIWAVEBRIEF_PUSH_EMAIL_SMTP_PORT=465
# AIWAVEBRIEF_PUSH_EMAIL_SMTP_USER=your@gmail.com
# AIWAVEBRIEF_PUSH_EMAIL_SMTP_PASSWORD=your-app-password
# AIWAVEBRIEF_PUSH_EMAIL_FROM_ADDR=your@gmail.com
# AIWAVEBRIEF_PUSH_EMAIL_TO_ADDRS=["recipient@example.com"]

# === 推送配置 - Webhook（可选） ===
# AIWAVEBRIEF_PUSH_WEBHOOK_URL=https://hooks.example.com/notify
# AIWAVEBRIEF_PUSH_WEBHOOK_HEADERS={"Authorization": "Bearer token"}

# === 日志配置（可选） ===
# AIWAVEBRIEF_LOGGING_LEVEL=INFO
# AIWAVEBRIEF_LOGGING_FORMAT=structured

# === 信源覆盖（可选，JSON 数组） ===
# AIWAVEBRIEF_SOURCES_JSON=[{"name":"arXiv AI","url":"https://arxiv.org/list/cs.AI/recent","category":"research","enabled":true}]
